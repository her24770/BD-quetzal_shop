version: "3.9"

services:
  db:
    container_name: quetzalshop-db
    image: postgres:15
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./back-end/sql/schema.sql:/docker-entrypoint-initdb.d/01_schema.sql
      - ./back-end/sql/views.sql:/docker-entrypoint-initdb.d/02_views.sql
      - ./back-end/sql/seed.sql:/docker-entrypoint-initdb.d/03_seed.sql
      - ./back-end/sql/stored_procedures.sql:/docker-entrypoint-initdb.d/04_stored_procedures.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    container_name: quetzalshop-back
    build:
      context: ./back-end
      dockerfile: Dockerfile
    ports:
      - "${APP_PORT}:8000"
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - .env
    volumes:
      - ./back-end:/app

  frontend:
    container_name: quetzalshop-front
    build:
      context: ./front-end
      dockerfile: Dockerfile
    ports:
      - "${FRONTEND_PORT}:5173"
    depends_on:
      - backend
    env_file:
      - .env
    volumes:
      - ./front-end:/app
      - /app/node_modules

volumes:
  postgres_data:
