# Base de datos — owner (solo Docker init: schema + seed)
DB_HOST=db
DB_PORT=5432  # no cambiar — puerto interno de Docker cambiar solo en caso de conflictos con otro servicio local dentro del contenedor
DB_NAME=quetzalshop_db
DB_USER=proy2
DB_PASSWORD=secret

# Credenciales de los 5 roles de PostgreSQL (las usa el API en runtime)
DB_ADMIN_PASSWORD=admin_secret
DB_CAJERO_PASSWORD=cajero_secret
DB_BODEGUERO_PASSWORD=bodeguero_secret
DB_GERENTE_PASSWORD=gerente_secret
DB_AUDITOR_PASSWORD=auditor_secret

# JWT
JWT_SECRET=ejemplo_clave
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Backend
APP_PORT=8000
APP_ENV=development
# CORS — si cambias FRONTEND_PORT, actualiza este valor con el mismo puerto, tambien puedes listar varios orígenes separados por comas, por ejemplo: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
# URL del backend que el navegador usará para llamar a la API
VITE_API_URL=http://localhost:8000
