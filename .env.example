# ─── Base de datos ────────────────────────────────────────────────────────────
# DB_HOST es el nombre del servicio Docker (red interna). NO cambiar.
DB_HOST=db
# DB_PORT es el puerto interno de PostgreSQL dentro del contenedor.
# NO cambiar: el contenedor siempre escucha en 5432 y no expone puerto al host.
# Cambiarlo rompe la conexión del backend al arrancar.
DB_PORT=5432
DB_NAME=quetzalshop_db
# Credenciales fijas requeridas por la rúbrica — NO cambiar.
DB_USER=proy3
DB_PASSWORD=secret

# Credenciales de los 5 roles de PostgreSQL (las usa el API en runtime)
DB_ADMIN_PASSWORD=admin_secret
DB_CAJERO_PASSWORD=cajero_secret
DB_BODEGUERO_PASSWORD=bodeguero_secret
DB_GERENTE_PASSWORD=gerente_secret
DB_AUDITOR_PASSWORD=auditor_secret

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=ejemplo_clave
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Backend ──────────────────────────────────────────────────────────────────
# Puerto donde el backend es accesible en el host (http://localhost:APP_PORT).
# Si lo cambias, actualiza también VITE_API_URL con el mismo puerto,
# de lo contrario el frontend no encontrará el backend.
APP_PORT=8000
APP_ENV=development
# CORS — orígenes permitidos para llamar al backend.
# Si cambias FRONTEND_PORT, cambia este valor al nuevo puerto del frontend.
# Separar múltiples orígenes con coma, sin espacios: http://localhost:3000,http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Puerto donde el frontend es accesible en el host (http://localhost:FRONTEND_PORT).
# Si lo cambias, actualiza también CORS_ORIGINS con el mismo puerto,
# de lo contrario el backend rechazará las peticiones del frontend (error CORS).
FRONTEND_PORT=3000
# URL que el navegador usa para llamar al backend.
# Debe coincidir con APP_PORT. Si cambias APP_PORT, cambia el puerto aquí también.
VITE_API_URL=http://localhost:8000
